# Copy to .env and fill in. Never commit .env.
#
# In Docker (docker compose), N8N_WEBHOOK_URL and CERTSTREAM_URL are already
# set in docker-compose.yml to the internal service names, so you only need
# the optional values below.

# Optional shared secret, must match Header Auth in the n8n Webhook node.
N8N_WEBHOOK_TOKEN=

# Only used when running WITHOUT n8n (direct Telegram mode).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# When running Python directly on your machine (not in Docker), uncomment:
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/ukphish-detection
# CERTSTREAM_URL=ws://localhost:8080/
